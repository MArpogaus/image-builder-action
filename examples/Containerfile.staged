# Multi-stage: a scratch helper stage carries build files, the real base
# sits behind it, and a second real base reuses the same ARG. The action
# verifies and pins every non-scratch FROM and leaves scratch alone.
FROM scratch AS ctx
COPY examples/Containerfile.staged /payload.txt

ARG BASE_IMAGE

FROM ${BASE_IMAGE} AS tool
RUN echo tool > /staged-tool.txt

FROM ${BASE_IMAGE}
COPY --from=ctx /payload.txt /copied.txt
COPY --from=tool /staged-tool.txt /tool.txt
RUN --mount=type=bind,from=ctx,target=/ctx cp /ctx/payload.txt /mounted.txt
